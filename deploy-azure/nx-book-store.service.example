[Unit]
Description=nx.book-store.com.pl Next.js app (Azure VM)
After=network.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/var/www/nx-book-store/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
EnvironmentFile=/var/www/nx-book-store/shared/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
