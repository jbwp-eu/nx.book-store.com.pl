NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DEPLOY_TARGET=ovh
NEXT_PUBLIC_DEPLOY_TARGET=ovh

# Prisma Postgres (managed) — not a local DB on the VPS
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

AUTH_SECRET=change-me-long-random
AUTH_TRUST_HOST=true
AUTH_URL=https://nx.book-store.com.pl

NEXT_PUBLIC_APP_URL=https://nx.book-store.com.pl

# Stripe — active pair follows DEPLOY_TARGET (ovh | azure)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST_MODE_OVH=pk_test_...
STRIPE_SECRET_KEY_TEST_MODE_OVH=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST_MODE_OVH=whsec_...

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST_MODE_AZURE=
STRIPE_SECRET_KEY_TEST_MODE_AZURE=
STRIPE_WEBHOOK_SECRET_TEST_MODE_AZURE=

PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=products
AZURE_STORAGE_ACCOUNT_NAME=

PAGE_SIZE=5

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@book-store.com.pl
ADMIN_EMAIL=admin@book-store.com.pl

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
